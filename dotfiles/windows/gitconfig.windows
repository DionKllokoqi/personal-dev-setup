[user]
        name = YOUR_NAME
        email = you@example.com
[diff]
        tool = p4merge
[difftool "p4merge"]
        cmd = "C:/Program Files/Perforce/p4merge.exe" "$LOCAL" "$REMOTE"
[difftool]
        prompt = false
[merge]
        tool = p4merge
[mergetool "p4merge"]
        cmd = "C:/Program Files/Perforce/p4merge.exe" "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
        trustExitCode = false
[mergetool]
        prompt = false
[credential]
        helper = manager-core
        useHttpPath = true
[alias]
        hist = log --oneline --graph --decorate --all
[core]
        autocrlf = input
        excludesFile = ~/.gitignore_global
        safecrlf = false
[init]
        defaultBranch = main
